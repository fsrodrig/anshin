root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4

[{*.go,go.mod,Makefile}]
indent_style = tab

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[contract/captures/**]
# Captures are byte-exact copies of kernel files, trailing whitespace and missing final newlines included.
insert_final_newline = false
trim_trailing_whitespace = false
